          "name": "List my chats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat?archived=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ],
              "query": [
                {
                  "key": "archived",
                  "value": "false"
                }
              ]
            }
          }
        },
        {
          "name": "List my archived chats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat?archived=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat"
              ],
              "query": [
                {
                  "key": "archived",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Get chat by id",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
