          "name": "Mark favourite",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/favourite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isFavourite\": true\n}"
            }
          }
        },
        {
          "name": "Unmark favourite",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/favourite",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isFavourite\": false\n}"
            }
          }
        },
        {
          "name": "Archive chat",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/archive",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isArchived\": true\n}"
            }
          }
        },
        {
          "name": "Unarchive chat",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/archive",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isArchived\": false\n}"
            }
          }
        },
        {
          "name": "Block chat",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/block",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": true\n}"
            }
          }
        },
        {
          "name": "Unblock chat",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/block",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isBlocked\": false\n}"
            }
          }
        },
        {
          "name": "Mark read (reset unread counter)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/read"
          }
        },
        {
          "name": "Update group settings",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{groupChatId}}/settings",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"groupName\": \"Design Team (Updated)\",\n  \"lockSettings\": true,\n  \"enableAIAnswer\": false,\n  \"simpleModeOn\": false\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Membership & Leave",
      "item": [
        {
          "name": "Add members to group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{groupChatId}}/members",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"memberIds\": [{{otherUserId}}]\n}"
            },
            "description": "Also live-joins already-connected sockets for these users into the chat room \u2014 see docs/CHAT_SOCKET.md."
          }
        },
        {
          "name": "Remove member from group",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{groupChatId}}/members/{{otherUserId}}",
            "description": "No permission check today \u2014 any participant can remove any other participant, not just the admin."
          }
        },
        {
          "name": "Leave chat (self)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{secondUserToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{groupChatId}}/leave",
            "description": "If the leaving user was the group admin and members remain, the oldest remaining member (by chat_members.createdAt) is auto-promoted to admin. If they were the last member, adminId is cleared to null instead of pointing at someone no longer in the chat."
          }
        }
      ]
    },
    {
      "name": "5. Delete",
      "item": [
        {
          "name": "Delete chat entirely",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}",
            "description": "Cascades: removes chat_members and chat_services rows too. No confirmation step."
          }
        }
      ]
    },
    {
      "name": "6. Messages (REST: history/seen/delete only)",
      "description": "Message CREATION is socket-only \u2014 there is no POST here. Use a socket.io-client to emit 'send message' first (see docs/CHAT_SOCKET.md), then use these to read/mark-seen/delete what was created.",
      "item": [
        {
          "name": "Get message history (paginated)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/chat/{{chatId}}/messages?page=1&pageSize=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "chat",
                "{{chatId}}",
                "messages"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "30"
                }
              ]
            },
            "description": "Oldest\u2192newest per page. Messages the caller has soft-deleted for themselves are excluded. 403 if the caller isn't a participant of chatId.\n\nNested attachment shapes: media is { type, mediaUrl, thumbnailUrl } (type mirrors message_type: image/video/audio/file). payment is { paymentRequestId, amount, currency, note, status, type, requesterId, requesteeId, createdAt, updatedAt } \u2014 note replaces the old description field; type is 'paymentSend'/'paymentReceived' (viewer-dependent) for a direct send via /payment/create-payment, or always 'paymentRequest' for both sides of a request via /payment/request-payment, with status moving pending -> accepted/rejected as the requestee acts on it (see '7. Payments'); createdAt/updatedAt are epoch-millisecond timestamps (updatedAt moves when accepted/rejected), same convention as the message's own created_at/updated_at."
          }
        },
        {
          "name": "Mark message uploaded (clears isUploading)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/messages/{{messageId}}/uploaded",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uploadingPercentage\": 100\n}"
            },
            "description": "Every message is created with isUploading:1 regardless of type (send message, socket-only). This clears it to 0 and broadcasts a 'message updated' event to chat-<chatId> so other connected clients update live. uploadingPercentage defaults to 100 if omitted."
          }
        },
        {
          "name": "Mark messages as seen",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{secondUserToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/{{chatId}}/messages/seen",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messageIds\": [{{messageId}}]\n}"
            },
            "description": "Adds the caller to seenMessagePersons for each id. Idempotent \u2014 marking an already-seen message again is a no-op."
          }
        },
        {
          "name": "Delete message for me",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/chat/messages/{{messageId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDeleteAll\": false\n}"
            },
            "description": "isDeleteAll:false = hidden for the caller only, everyone else still sees it. The DB row and other users' access are unaffected."
          }
        }
      ]
    },
    {
      "name": "7. Payments (request/send + accept/reject)",
      "description": "Lives under /api/payment, not /api/chat — grouped here because payment is a message attachment type (messageType: 'payment') and accept/reject broadcast 'message updated' into the chat over the socket (docs/CHAT_SOCKET.md §3). No chat/participant check on creation — a payment request/send can target any requesteeId regardless of whether you share a chat. It only shows up in a chat once you separately emit 'send message' (socket) with the resulting paymentRequestId.",
      "item": [
        {
          "name": "Create payment request (ask to be paid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('paymentRequestId', json.id); console.log('paymentRequestId saved:', json.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/payment/request-payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requesteeId\": {{otherUserId}},\n  \"amount\": 50.00,\n  \"currency\": \"CNY\",\n  \"description\": \"Deposit for sample order\"\n}"
            },
            "description": "Caller (user A) is requesterId — asking requesteeId (user B) to pay them. Creates a payment_requests row with kind: 'request', status: 'pending'. Response is the raw PaymentRequest row (NOT wrapped in {success}), with requester/requestee user objects included. paymentRequestId auto-saves from the response's id. Attach it to a chat next via socket 'send message' with { chatId, messageType: 'payment', paymentRequestId }."
          }
        },
        {
          "name": "Send payment directly (already completed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{userToken}}"
              }
            ],
            "url": "{{baseUrl}}/payment/create-payment",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requesteeId\": {{otherUserId}},\n  \"amount\": 50.00,\n  \"currency\": \"CNY\",\n  \"walletType\": \"PERSONAL\",\n  \"description\": \"Paid in full\"\n}"
            },
            "description": "Caller (user A) is requesterId and the PAYER here — immediately transfers the balance requester -> requestee via the wallet system and creates the payment_requests row with kind: 'direct', status: 'accepted' (no pending/accept step). Requires both users to already have a PERSONAL wallet in that currency (404 otherwise). Attach it to a chat the same way as a request; formatMessage will show payment.type as paymentSend/paymentReceived per viewer instead of paymentRequest, since kind is 'direct'."
          }
        },
        {
          "name": "Accept payment request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{secondUserToken}}"
              }
            ],
            "url": "{{baseUrl}}/payment/request-payment/{{paymentRequestId}}/accept",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"walletType\": \"PERSONAL\"\n}"
            },
            "description": "Only the requesteeId on the request (user B here) can call this, and only while status is 'pending' and kind is 'request' — 403/400 otherwise. Moves funds requestee -> requester (reverse direction from 'Send payment directly'), sets status: 'accepted'. walletType is optional, defaults to PERSONAL (it's the requestee's own wallet they're paying from). Response: { success, data: <PaymentRequest row>, message: <formatted chat message, or null if this paymentRequestId was never attached to one via 'send message'> }. If message is non-null, it was also just broadcast as 'message updated' into chat-<chatId>."
          }
        },
        {
          "name": "Reject payment request",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{secondUserToken}}"
              }
            ],
            "url": "{{baseUrl}}/payment/request-payment/{{paymentRequestId}}/reject",
            "description": "Same authorization/state rules as accept (requestee only, status must be 'pending'). No funds move — sets status: 'rejected'. Same response shape and 'message updated' broadcast behavior as accept."
          }
        }
      ]
    }
  ]
}
