EmailService_Key=

# Redis — socket.io cross-process adapter + presence store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base URL for Stripe redirect pages
# Development:  http://localhost:3000
# Production:   https://yourdomain.com
APP_BASE_URL=http://localhost:3000

# Accounts allowed to add / edit / delete app versions (comma-separated emails, admin role also required)
APP_VERSION_ADMIN_EMAILS=noumanhabib0348@gmail.com

# Google Sign-In (no Firebase) — comma-separated OAuth client ids the app's
# ID tokens are issued for. With google_sign_in's serverClientId this is the
# Google Cloud project's *Web* client id.
GOOGLE_CLIENT_IDS=

# JPush (replaces FCM; reaches mainland China via vendor channels).
# App key + master secret: JPush console → your app → Settings.
JPUSH_APP_KEY=
JPUSH_MASTER_SECRET=
# "false" while testing with development/TestFlight iOS builds
JPUSH_APNS_PRODUCTION=true
# Optional vendor channel options (JSON for options.third_party_channel)
JPUSH_THIRD_PARTY_CHANNEL=
